{ ... }:
{
  xdg = {
    configFile."mimeapps.list".force = true;
    mimeApps =
      let
        chromium = "chromium-browser.desktop";
        discord = "discord.desktop";
        gimp = "gimp.desktop";
        codium = "codium.desktop";
        ristretto = "org.xfce.ristretto.desktop";
        inkscape = "org.inkscape.Inkscape.desktop";
        krita = "krita_psd.desktop";
        mpv = "mpv.desktop";
        neovim = "nvim.desktop";
        thunar = "thunar.desktop";
        qpdfview = "org.gnome.qpdfview.desktop";
      in
      {
        enable = true;
        associations.added = {
          "application/pdf" = [ qpdfview ];
          "application/vnd.ms-publisher" = [ codium neovim ];
          "application/x-extension-htm" = [ chromium ];
          "application/x-extension-html" = [ chromium ];
          "application/x-extension-shtml" = [ chromium ];
          "application/x-extension-xht" = [ chromium ];
          "application/x-extension-xhtml" = [ chromium ];
          "application/xhtml+xml" = [ chromium ];
          "application/xml" = [ codium neovim ];
          "audio/aac" = [ mpv ];
          "audio/flac" = [ mpv ];
          "audio/mp4" = [ mpv ];
          "audio/mpeg" = [ mpv ];
          "audio/ogg" = [ mpv ];
          "audio/vorbis" = [ mpv ];
          "audio/x-wav" = [ mpv ];
          "image/gif" = [ ristretto ];
          "image/jpeg" = [ ristretto ];
          "image/png" = [ ristretto ];
          "image/svg+xml" = [ inkscape ];
          "image/vnd.adobe.photoshop" = [ krita ];
          "image/webp" = [ ristretto ];
          "image/x-eps" = [ inkscape ];
          "image/x-xcf" = [ gimp ];
          "inode/directory" = [ thunar ];
          "text/html" = [ chromium ];
          "text/markdown" = [ codium neovim ];
          "text/plain" = [ neovim codium ];
          "text/uri-list" = [ chromium ];
          "video/mp4" = [ mpv ];
          "video/ogg" = [ mpv ];
          "video/webm" = [ mpv ];
          "video/x-flv" = [ mpv ];
          "video/x-matroska" = [ mpv ];
          "video/x-ms-wmv" = [ mpv ];
          "video/x-ogm+ogg" = [ mpv ];
          "video/x-theora+ogg" = [ mpv ];
          "x-scheme-handler/about" = [ chromium ];
          "x-scheme-handler/chrome" = [ chromium ];
          "x-scheme-handler/discord" = [ discord ];
          "x-scheme-handler/ftp" = [ chromium ];
          "x-scheme-handler/http" = [ chromium ];
          "x-scheme-handler/https" = [ chromium ];
          "x-scheme-handler/unknown" = [ chromium ];
        };
        defaultApplications = {
          "application/pdf" = [ qpdfview ];
          "application/vnd.ms-publisher" = [ codium neovim ];
          "application/x-extension-htm" = [ chromium ];
          "application/x-extension-html" = [ chromium ];
          "application/x-extension-shtml" = [ chromium ];
          "application/x-extension-xht" = [ chromium ];
          "application/x-extension-xhtml" = [ chromium ];
          "application/xhtml+xml" = [ chromium ];
          "application/xml" = [ codium neovim ];
          "audio/aac" = [ mpv ];
          "audio/flac" = [ mpv ];
          "audio/mp4" = [ mpv ];
          "audio/mpeg" = [ mpv ];
          "audio/ogg" = [ mpv ];
          "audio/vorbis" = [ mpv ];
          "audio/x-wav" = [ mpv ];
          "image/gif" = [ ristretto ];
          "image/jpeg" = [ ristretto ];
          "image/png" = [ ristretto ];
          "image/svg+xml" = [ inkscape ];
          "image/vnd.adobe.photoshop" = [ krita ];
          "image/webp" = [ ristretto ];
          "image/x-eps" = [ inkscape ];
          "image/x-xcf" = [ gimp ];
          "inode/directory" = [ thunar ];
          "text/html" = [ chromium ];
          "text/markdown" = [ codium neovim ];
          "text/plain" = [ neovim codium ];
          "text/uri-list" = [ chromium ];
          "video/mp4" = [ mpv ];
          "video/ogg" = [ mpv ];
          "video/webm" = [ mpv ];
          "video/x-flv" = [ mpv ];
          "video/x-matroska" = [ mpv ];
          "video/x-ms-wmv" = [ mpv ];
          "video/x-ogm+ogg" = [ mpv ];
          "video/x-theora+ogg" = [ mpv ];
          "x-scheme-handler/about" = [ chromium ];
          "x-scheme-handler/chrome" = [ chromium ];
          "x-scheme-handler/discord" = [ discord ];
          "x-scheme-handler/ftp" = [ chromium ];
          "x-scheme-handler/http" = [ chromium ];
          "x-scheme-handler/https" = [ chromium ];
          "x-scheme-handler/unknown" = [ chromium ];
        };
      };
  };
}
